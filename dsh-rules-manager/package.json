{
  "name": "dsh-rules-manager",
  "version": "1.4.1",
  "description": "DeepSeek Harness (dsh) rules, commands & skills manager: /rules slash command, settings panel with visual rule editing, command list, user-defined custom commands (with {input} argument support, disable/enable), skill management (view/disable/enable/delete-to-trash), and backup restore. Installable as an official dsh bundle.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./service.js": "./service.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "service.js",
    "rules-core.js",
    "skills-core.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "rules",
    "commands",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-rules-manager-client": "1.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-home-paths": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.3"
  },
  "scripts": {
    "test": "node test-service.js && node test-local.js"
  }
}
